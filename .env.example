# ==============================================================================
# KOMA — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Database: PostgreSQL (Vercel Postgres / Neon)
POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# DATABASE_URL="postgresql://user:password@localhost:5432/koma"

# Storage: Vercel Blob (Image Uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
# Required to bind reviewed upload URLs to the anonymous session (generate a strong random value)
IMAGE_UPLOAD_SIGNING_SECRET="replace_with_a_long_random_server_secret"
# Images are sent to the configured moderation/vision provider before public upload.
# The provider must support POST /moderations (omni-moderation-latest) and vision chat completions.
# AI_IMAGE_MODERATION_API_KEY="sk-your-moderation-key"
# AI_IMAGE_MODERATION_BASE_URL="https://api.openai.com/v1"
# AI_IMAGE_MODERATION_MODEL="gpt-4o-mini"

# Administrative Access
# WAJIB DIKONFIGURASI di .env.local / production environment!
# Sistem menolak seluruh akses admin secara total jika variabel ini kosong atau tidak diset.
ADMIN_PASSWORD="isi_dengan_password_admin_yang_sangat_kuat_dan_rahasia"

# AI Integration: Custom OpenAI-Compatible Provider
# (Called only from Next.js server-side routes; exact model IDs supported by provider)
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="sk-your-custom-ai-key"
AI_MODEL="gpt-4o-mini"
AI_FALLBACK_MODEL="gpt-3.5-turbo"

# Optional: Separate Image Generation API (Kept strictly decoupled from text API)
# AI_IMAGE_BASE_URL="https://api.openai.com/v1"
# AI_IMAGE_API_KEY="sk-your-image-key"
# AI_IMAGE_MODEL="dall-e-3"
